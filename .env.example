# ============================================================
# 复制本文件为 .env 并填写（.env 不要提交/分享给任何人）
# ============================================================

# ---------- Lofter 登录 ----------
# 浏览器登录 Lofter 后，F12 → 应用(Application) → Cookie → https://www.lofter.com，
# 按你的登录方式找到下表对应的 cookie，把【值】复制填到 LOFTER_COOKIE=（只填一个值就认）：
#   QQ / 微信 / 微博 登录 -> LOFTER_SESS            （最常见，HttpOnly 那个）
#   邮箱登录              -> NTES_SESS
#   手机号登录            -> LOFTER-PHONE-LOGIN-AUTH
#   Lofter id 登录        -> Authorization
# 拿不准就用整行：F12 → 网络(Network) → 刷新 → 点任一条 www.lofter.com 请求 →
# 请求标头(Request Headers) → 复制整行 Cookie 的值（里面有很多键值对，全部粘进来）。
LOFTER_COOKIE=

# 或者分两个字段填单个登录 cookie（与上面等价，二选一）：
# LOFTER_LOGIN_KEY 填上表中的 cookie 名，LOFTER_LOGIN_AUTH 填它的值
LOFTER_LOGIN_KEY=
LOFTER_LOGIN_AUTH=

# ---------- LLM（OpenAI 兼容接口） ----------
# 这里配的是「主提供商」；要用更多提供商（不同 base_url + api_key 并存），
# 到 GUI 设置页「模型提供商」分组添加，然后在「模型分配」里用「提供商名/模型名」引用。
# 火山方舟（豆包）：https://ark.cn-beijing.volces.com/api/v3
# DeepSeek：https://api.deepseek.com/v1    智谱：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
# 模型名或推理接入点 ID（火山方舟填你开通的接入点/模型，如 doubao-xxx）
LLM_MODEL=
